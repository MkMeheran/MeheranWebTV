<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus Ring (Amber) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/amber_400" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Main Border -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/stone_900" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Dark Shadow (Bottom Right) -->
    <item android:top="7dp" android:left="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nes_shadow_dark" />
            <corners android:radius="5dp" />
        </shape>
    </item>

    <!-- Light Shadow (Top Left) over Dark Shadow -->
    <item android:top="7dp" android:left="7dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/nes_shadow_light" />
            <corners android:radius="5dp" />
        </shape>
    </item>

    <!-- Main Background -->
    <item android:top="10dp" android:left="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/stone_100" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
